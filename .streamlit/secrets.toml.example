# Copiez ce fichier en `.streamlit/secrets.toml` (ignoré par git) pour activer la
# sauvegarde automatique des caches dans un Gist GitHub PRIVÉ.
# Sans ce fichier l'app fonctionne normalement : les données restent seulement en local
# (dossier .cache/).
#
# Sur Streamlit Community Cloud : coller ce contenu dans Settings → Secrets.

[gist]
# Token GitHub (Settings → Developer settings → Personal access tokens), scope « gist » suffisant
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Laisser vide au premier lancement : un Gist privé est créé automatiquement,
# puis recopier ici son identifiant pour que les prochains démarrages le réutilisent.
gist_id = ""
